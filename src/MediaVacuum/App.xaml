<Application x:Class="MediaVacuum.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MediaVacuum.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Light.xaml" />
                <ResourceDictionary Source="Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
