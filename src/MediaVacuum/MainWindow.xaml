<Window x:Class="MediaVacuum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaVacuum.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding T[AppTitle]}"
        Icon="/Assets/logo_app.png"
        Width="1240"
        Height="840"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnUrlDrop">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="46" Height="46" Margin="0,0,12,0">
                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10">
                    <TextBlock Text="MV"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Image Source="/Assets/logo_app.png" Stretch="Uniform" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding T[AppTitle]}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="10,2,0,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding T[YtDlpVersion], Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding YtDlpVersion, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                        </TextBlock>
                    </Border>
                    <Button Content="{Binding UpdateAvailableText}"
                            Command="{Binding CheckUpdateCommand}"
                            Style="{StaticResource LinkButton}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding AppUpdateAvailableText}"
                            Command="{Binding InstallAppUpdateCommand}"
                            Style="{StaticResource LinkButton}"
                            Foreground="{DynamicResource AccentBrush}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{Binding T[InstallAppUpdateTooltip]}"
                            Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding T[AppSubtitle]}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding T[Language]}" Style="{StaticResource Label}" />
                    <ComboBox Width="128"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding T[Theme]}" Style="{StaticResource Label}" />
                    <ComboBox Width="118" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTheme}">
                        <ComboBoxItem Tag="System" Content="{Binding T[ThemeSystem]}" />
                        <ComboBoxItem Tag="Light" Content="{Binding T[ThemeLight]}" />
                        <ComboBoxItem Tag="Dark" Content="{Binding T[ThemeDark]}" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== URL bar ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding T[UrlTooltip]}"
                             FontSize="14"
                             MinHeight="38"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding T[UrlPlaceholder]}"
                               IsHitTestVisible="False"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding Url, Converter={StaticResource EmptyStringToVisibility}}" />
                </Grid>

                <Button Grid.Column="1"
                        Content="{Binding T[Analyze]}"
                        Command="{Binding AnalyzeCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="96"
                        Height="38" />

                <Button Grid.Column="2"
                        Content="{Binding T[Download]}"
                        Command="{Binding StartDownloadCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="118"
                        Height="38" />

                <Button Grid.Column="3"
                        Content="{Binding T[Cancel]}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DangerButton}"
                        Margin="8,0,0,0"
                        Height="38"
                        Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ===== Queue + options ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="362" />
            </Grid.ColumnDefinitions>

            <!-- Queue card -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding T[Queue]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding QueueCountText}"
                                       Style="{StaticResource Muted}"
                                       Margin="10,4,0,0" />
                            <TextBlock Text="{Binding SelectedCountText}"
                                       Style="{StaticResource Muted}"
                                       Margin="8,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding T[SelectAll]}"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource LinkButton}" />
                            <Button Content="{Binding T[DeselectAll]}"
                                    Command="{Binding DeselectAllCommand}"
                                    Style="{StaticResource LinkButton}"
                                    Margin="8,0,0,0" />
                            <Button Content="{Binding T[Clear]}"
                                    Command="{Binding ClearQueueCommand}"
                                    Style="{StaticResource LinkButton}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="54" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="{Binding T[Title]}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="3" Text="{Binding T[Duration]}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="4" Text="{Binding T[Size]}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="5" Text="{Binding T[Progress]}" Style="{StaticResource Muted}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Queue}" Margin="0,0,-6,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2,8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Width="94"
                                                Height="54"
                                                CornerRadius="7"
                                                Background="{DynamicResource ThumbBrush}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="▶"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="10,2,10,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ErrorBrush}"
                                                           Margin="8,0,0,0"
                                                           MaxWidth="260"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ErrorMessage}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DurationText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,2,8,2">
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Height="5" />
                                            <TextBlock Text="{Binding ProgressDetailText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    Width="17"
                                                    Height="24"
                                                    FontSize="10"
                                                    ToolTip="{Binding DataContext.T[OpenFile], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="⧉"
                                                    Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    Width="17"
                                                    Height="24"
                                                    FontSize="10"
                                                    ToolTip="{Binding DataContext.T[OpenFileLocation], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    Width="17"
                                                    Height="24"
                                                    FontSize="10"
                                                    ToolTip="{Binding DataContext.T[Remove], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="Transparent"
                                Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                                <TextBlock Text="🎬"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           Opacity="0.7" />
                                <TextBlock Text="{Binding T[QueueEmptyTitle]}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4" />
                                <TextBlock Text="{Binding T[QueueEmptyHint]}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="380" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0"
                                             Value="{Binding OverallProgress, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsOverallIndeterminate, Mode=OneWay}"
                                             Height="6"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           Style="{StaticResource Muted}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <TextBlock Text="{Binding TotalSizeText}"
                                       Style="{StaticResource Muted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button Content="{Binding T[OpenFolder]}"
                                    Command="{Binding OpenOutputCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Options card -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="{Binding T[Options]}">
                        <StackPanel>
                            <TextBlock Text="{Binding T[OutputFolder]}" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" />
                                <Button Grid.Column="1"
                                        Content="{Binding T[Browse]}"
                                        Command="{Binding BrowseOutputCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="6,0,0,0" />
                                <Button Grid.Column="2"
                                        Content="↗"
                                        Command="{Binding OpenOutputCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="6,0,0,0"
                                        Width="34"
                                        ToolTip="{Binding T[OpenFolder]}" />
                            </Grid>

                            <CheckBox Content="{Binding T[IncludePlaylist]}"
                                      IsChecked="{Binding IncludePlaylist}"
                                      ToolTip="{Binding T[IncludePlaylistTooltip]}"
                                      Margin="0,12,0,0" />
                            <CheckBox Content="{Binding T[CreatePlaylistFolder]}"
                                      IsChecked="{Binding CreatePlaylistFolder}"
                                      ToolTip="{Binding T[CreatePlaylistFolderTooltip]}" />
                            <CheckBox Content="{Binding T[IncludeVideoId]}"
                                      IsChecked="{Binding IncludeVideoId}"
                                      ToolTip="{Binding T[IncludeVideoIdTooltip]}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding T[Format]}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Content="{Binding T[ModeVideo]}"
                                             IsChecked="{Binding IsVideoMode}"
                                             GroupName="DownloadMode" />
                                <RadioButton Content="{Binding T[ModeAudio]}"
                                             IsChecked="{Binding IsAudioMode}"
                                             GroupName="DownloadMode"
                                             Margin="16,0,0,0" />
                            </StackPanel>

                            <StackPanel IsEnabled="{Binding IsVideoMode}">
                                <TextBlock Text="{Binding T[VideoFormat]}" Style="{StaticResource Label}" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding VideoPreset}">
                                    <ComboBoxItem Tag="best" Content="{Binding T[FormatBest]}" />
                                    <ComboBoxItem Tag="2160p" Content="{Binding T[Format2160p]}" />
                                    <ComboBoxItem Tag="1440p" Content="{Binding T[Format1440p]}" />
                                    <ComboBoxItem Tag="1080p" Content="{Binding T[Format1080p]}" />
                                    <ComboBoxItem Tag="720p" Content="{Binding T[Format720p]}" />
                                    <ComboBoxItem Tag="480p" Content="{Binding T[Format480p]}" />
                                    <ComboBoxItem Tag="360p" Content="{Binding T[Format360p]}" />
                                </ComboBox>

                                <TextBlock Text="{Binding T[VideoContainer]}" Style="{StaticResource Label}" Margin="0,10,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding VideoContainer}">
                                    <ComboBoxItem Tag="auto" Content="{Binding T[ContainerAuto]}" />
                                    <ComboBoxItem Tag="mp4" Content="{Binding T[ContainerMp4]}" />
                                    <ComboBoxItem Tag="mkv" Content="{Binding T[ContainerMkv]}" />
                                    <ComboBoxItem Tag="webm" Content="{Binding T[ContainerWebm]}" />
                                    <ComboBoxItem Tag="mp4-recode" Content="{Binding T[ContainerMp4Recode]}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel IsEnabled="{Binding IsAudioMode}" Margin="0,10,0,0">
                                <TextBlock Text="{Binding T[AudioFormat]}" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding AudioFormats}"
                                          SelectedItem="{Binding AudioFormat}" />
                            </StackPanel>

                            <TextBlock Text="{Binding T[CustomFormat]}" Style="{StaticResource Label}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding CustomFormat, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="{Binding T[CustomFormatTooltip]}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding T[Metadata]}">
                        <StackPanel>
                            <CheckBox Content="{Binding T[EmbedMetadata]}" IsChecked="{Binding EmbedMetadata}" />
                            <CheckBox Content="{Binding T[EmbedThumbnail]}"
                                      IsChecked="{Binding EmbedThumbnail}"
                                      ToolTip="{Binding T[EmbedThumbnailTooltip]}" />
                            <CheckBox Content="{Binding T[WriteThumbnail]}"
                                      IsChecked="{Binding WriteThumbnail}"
                                      ToolTip="{Binding T[WriteThumbnailTooltip]}" />
                            <CheckBox Content="{Binding T[DownloadSubtitles]}" IsChecked="{Binding WriteSubtitles}" />
                            <CheckBox Content="{Binding T[EmbedSubtitles]}" IsChecked="{Binding EmbedSubtitles}" />
                            <TextBlock Text="{Binding T[SubtitleLanguages]}" Style="{StaticResource Label}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding SubtitleLanguages, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding T[Advanced]}">
                        <StackPanel>
                            <TextBlock Text="{Binding T[ConcurrentDownloads]}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding ConcurrentDownloads}" />

                            <TextBlock Text="{Binding T[ConcurrentFragments]}" Style="{StaticResource Label}" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding FragmentOptions}" SelectedItem="{Binding ConcurrentFragments}" />

                            <TextBlock Text="{Binding T[LimitRate]}" Style="{StaticResource Label}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding LimitRateText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="{Binding T[LimitRateTooltip]}" />

                            <CheckBox Content="{Binding T[ProbeSizes]}"
                                      IsChecked="{Binding ProbeSizes}"
                                      ToolTip="{Binding T[ProbeSizesTooltip]}"
                                      Margin="0,12,0,0" />
                            <CheckBox Content="{Binding T[AutoCheckUpdates]}" IsChecked="{Binding AutoCheckUpdates}" />
                            <CheckBox Content="{Binding T[AutoUpdateApp]}"
                                      IsChecked="{Binding AutoUpdateApp}"
                                      ToolTip="{Binding T[AutoUpdateAppTooltip]}" />
                            <CheckBox Content="{Binding T[OverwriteExisting]}"
                                      IsChecked="{Binding OverwriteExisting}"
                                      ToolTip="{Binding T[OverwriteExistingTooltip]}" />

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding T[Ffmpeg]}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding FfmpegStatusText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Content="{Binding T[DownloadFfmpeg]}"
                                            Command="{Binding DownloadFfmpegCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420" />
                    <TextBlock Text=" · "
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding T[Logs]}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Content="{Binding T[OpenLogs]}"
                            Command="{Binding OpenLogsCommand}"
                            Style="{StaticResource LinkButton}"
                            Margin="6,0,0,0" />
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding T[RetryYtDlp]}"
                            Command="{Binding RetryYtDlpCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0"
                            Visibility="{Binding IsYtDlpReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <Button Content="{Binding T[CheckUpdate]}"
                            Command="{Binding CheckUpdateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0" />
                    <Button Content="{Binding T[InstallMenu]}"
                            Command="{Binding InstallContextMenuCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0" />
                    <Button Content="{Binding T[RemoveMenu]}"
                            Command="{Binding UninstallContextMenuCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0" />
                    <Button Content="{Binding T[Uninstall]}"
                            Command="{Binding UninstallAppCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="4,0" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
