<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MediaVacuum.Core\MediaVacuum.Core.csproj" />
    <ProjectReference Include="..\MediaVacuum.Installer\MediaVacuum.Installer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_app.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Title>MediaVacuum</Title>
    <Description>GUI wrapper for yt-dlp - download and convert media</Description>
    <Company>MediaVacuum</Company>
    <Product>MediaVacuum</Product>
    <AssemblyName>MediaVacuum</AssemblyName>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
